# ----------------------------------------------------------------------------
# Sanity CMS — copy this file to `.env.local` and fill in your project values.
# Find these at https://www.sanity.io/manage after creating a free project.
# ----------------------------------------------------------------------------

# Project ID (from sanity.io/manage). Required to enable live content + Studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset name. "production" is the default created with a new project.
NEXT_PUBLIC_SANITY_DATASET=production

# API version (date). Leave as-is unless you know you need a newer one.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ----------------------------------------------------------------------------
# Revalidation webhook secret. Set the SAME value here and in the Sanity
# webhook (Manage > API > Webhooks) so publishing instantly updates the site.
# ----------------------------------------------------------------------------
SANITY_REVALIDATE_SECRET=

# Legacy secret used by the older /api/revalidate?secret=... path. Optional.
MY_SECRET_TOKEN=
